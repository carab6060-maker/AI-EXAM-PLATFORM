# =============================================================================
# ENTERPRISE AI EXAM PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. Neon PostgreSQL Database Configuration
# Obtain these from your Neon Console (https://console.neon.tech) -> Connection Details -> Prisma tab
# Runtime pooled connection (port 6543 / -pooler domain with pgbouncer):
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-project-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct unpooled connection for migrations and schema pushes (port 5432 / direct endpoint):
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-project.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. JWT Authentication Secret (generate random 64-char key for production)
JWT_SECRET="enterprise_ai_exam_jwt_secret_key_2026_super_secure_string_9981"

# 3. Public Application URL (used for certificate verification links & QR codes)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# 4. Optional AI Provider API Key (Google Gemini / OpenAI for question generation)
GEMINI_API_KEY="your-gemini-api-key"

# 5. Environment
NODE_ENV="production"
