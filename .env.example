# Production PostgreSQL Connection:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_exam_platform?schema=public"

# Development / Local DB:
DATABASE_URL="file:./dev.db"

# JWT Auth Secret (replace with random 64-char key in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Application URL (for generating public certificate verification QR codes and links)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# AI Key (optional for live Gemini/OpenAI API calls)
GEMINI_API_KEY="your-gemini-or-ai-api-key"

NODE_ENV="development"
