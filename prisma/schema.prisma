// Prisma Schema for Multi-Tenant Enterprise AI Exam & Certification Platform (Neon PostgreSQL Production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// 1. ORGANIZATIONS / COMPANIES (Multi-Tenant Root)
// ---------------------------------------------------------
model Company {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  logo            String?
  email           String?
  phone           String?
  address         String?
  website         String?
  industry        String?
  registrationNo  String?
  status          String           @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  plan            String           @default("ENTERPRISE") // FREE, STARTER, PRO, ENTERPRISE
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users                   User[]
  departments             Department[]
  positions               Position[]
  employeeProfiles        EmployeeProfile[]
  subjects                Subject[]
  questions               Question[]
  exams                   Exam[]
  examAssignments         ExamAssignment[]
  examAttempts            ExamAttempt[]
  results                 Result[]
  certificates            Certificate[]
  aiAnalyses              AIAnalysis[]
  trainingRecommendations TrainingRecommendation[]
  trainingCourses         TrainingCourse[]
  trainingEnrollments     TrainingEnrollment[]
  assessments             Assessment[]
  roles                   Role[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@index([status])
  @@index([code])
}

// ---------------------------------------------------------
// 2. USERS, ROLES & PERMISSIONS (RBAC & Auth)
// ---------------------------------------------------------
model User {
  id              String           @id @default(cuid())
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email           String           @unique
  passwordHash    String
  name            String
  role            String           @default("EMPLOYEE") // SUPER_ADMIN, COMPANY_ADMIN, HR_MANAGER, TRAINING_MANAGER, EXAMINER, DEPARTMENT_MANAGER, AUDITOR, EMPLOYEE
  status          String           @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employeeProfile         EmployeeProfile?
  createdSubjects         Subject[]                 @relation("SubjectCreator")
  createdQuestions        Question[]                @relation("QuestionCreator")
  createdExams            Exam[]                    @relation("ExamCreator")
  examAttempts            ExamAttempt[]
  results                 Result[]
  certificates            Certificate[]
  aiAnalyses              AIAnalysis[]
  trainingRecommendations TrainingRecommendation[]
  trainingEnrollments     TrainingEnrollment[]
  assessmentSubmissions   AssessmentSubmission[]
  userRoles               UserRole[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([status])
}

model Role {
  id          String           @id @default(cuid())
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String           // SUPER_ADMIN, COMPANY_ADMIN, HR_MANAGER, TRAINING_MANAGER, EXAMINER, EMPLOYEE
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. exams.create, exams.grade, employees.manage, certs.issue
  name        String
  category    String           // EXAMS, EMPLOYEES, CERTIFICATES, SYSTEM, TRAINING, REPORTS
  description String?
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([category])
  @@index([code])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ---------------------------------------------------------
// 3. EMPLOYEES, ORG STRUCTURE & DEPARTMENTS
// ---------------------------------------------------------
model Department {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  code            String
  description     String?
  headId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  teams           Team[]
  positions       Position[]
  employeeProfiles EmployeeProfile[]
  subjects        Subject[]
  examAssignments ExamAssignment[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Team {
  id              String           @id @default(cuid())
  departmentId    String
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employeeProfiles EmployeeProfile[]
  examAssignments ExamAssignment[]

  @@index([departmentId])
}

model Position {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  createdAt       DateTime         @default(now())

  employeeProfiles EmployeeProfile[]
  examAssignments ExamAssignment[]

  @@index([companyId])
  @@index([departmentId])
}

model EmployeeProfile {
  id                 String       @id @default(cuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId         String
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId             String?
  team               Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  positionId         String?
  position           Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  managerId          String?
  hireDate           DateTime?
  phone              String?
  skillsJson         String?      // JSON array of strings
  certificationsJson String?      // JSON array of objects
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  examAssignments    ExamAssignment[]

  @@unique([companyId, employeeId])
  @@index([companyId])
  @@index([userId])
  @@index([departmentId])
}

// ---------------------------------------------------------
// 4. SUBJECTS, TOPICS, QUESTIONS & OPTIONS
// ---------------------------------------------------------
model Subject {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  code            String
  description     String?
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category        String           @default("General")
  difficulty      String           @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  status          String           @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  createdById     String
  createdBy       User             @relation("SubjectCreator", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  topics          Topic[]
  questions       Question[]
  exams           Exam[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
}

model Topic {
  id              String           @id @default(cuid())
  subjectId       String
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  createdAt       DateTime         @default(now())

  questions       Question[]

  @@index([subjectId])
}

model Question {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questionText    String
  type            String           @default("MCQ") // MCQ, TRUE_FALSE, MULTIPLE_SELECT, SHORT_ANSWER, ESSAY, SCENARIO
  difficulty      String           @default("MEDIUM") // EASY, MEDIUM, HARD, EXPERT
  marks           Float            @default(1.0)
  explanation     String?
  tags            String?          // Comma-separated or JSON
  status          String           @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  createdById     String
  createdBy       User             @relation("QuestionCreator", fields: [createdById], references: [id])
  isAiGenerated   Boolean          @default(false)
  usageCount      Int              @default(0)
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  options         QuestionOption[]
  examQuestions   ExamQuestion[]
  attemptAnswers  AttemptAnswer[]

  @@index([companyId])
  @@index([subjectId])
  @@index([topicId])
  @@index([difficulty])
  @@index([status])
}

model QuestionOption {
  id              String           @id @default(cuid())
  questionId      String
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText      String
  isCorrect       Boolean          @default(false)
  orderIndex      Int              @default(0)

  @@index([questionId])
}

// ---------------------------------------------------------
// 5. EXAMS, ASSIGNMENTS & ATTEMPTS
// ---------------------------------------------------------
model Exam {
  id                  String           @id @default(cuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subjectId           String
  subject             Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title               String
  code                String
  description         String?
  instructions        String?
  examType            String           @default("CERTIFICATION") // PRACTICE, ASSESSMENT, CERTIFICATION, TRAINING_QUIZ, FINAL_EXAM
  durationMinutes     Int              @default(60)
  passScorePercent    Float            @default(70.0)
  totalMarks          Float            @default(100.0)
  questionCount       Int              @default(10)
  randomQuestions     Boolean          @default(false)
  randomOptions       Boolean          @default(false)
  allowRetakes        Boolean          @default(true)
  maxAttempts         Int              @default(3)
  isCertEligible      Boolean          @default(true)
  scheduleStart       DateTime?
  scheduleEnd         DateTime?
  timeZone            String           @default("UTC")
  fullScreenRequired  Boolean          @default(true)
  tabSwitchDetect     Boolean          @default(true)
  copyPasteRestrict   Boolean          @default(true)
  status              String           @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  createdById         String
  createdBy           User             @relation("ExamCreator", fields: [createdById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  examQuestions       ExamQuestion[]
  assignments         ExamAssignment[]
  attempts            ExamAttempt[]
  results             Result[]
  certificates        Certificate[]
  assessments         Assessment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([subjectId])
  @@index([status])
}

model ExamQuestion {
  id              String           @id @default(cuid())
  examId          String
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex      Int              @default(0)
  marks           Float            @default(1.0)

  @@index([examId])
  @@index([questionId])
}

model ExamAssignment {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  targetType      String           @default("INDIVIDUAL") // INDIVIDUAL, DEPARTMENT, TEAM, POSITION, ALL_COMPANY
  employeeProfileId String?
  employeeProfile EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  positionId      String?
  position        Position?        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assignedAt      DateTime         @default(now())
  dueDate         DateTime?
  status          String           @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED, EXPIRED

  @@index([companyId])
  @@index([examId])
  @@index([employeeProfileId])
  @@index([departmentId])
}

model ExamAttempt {
  id                     String          @id @default(cuid())
  companyId              String
  company                Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  examId                 String
  exam                   Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber          Int             @default(1)
  startedAt              DateTime        @default(now())
  submittedAt            DateTime?
  durationSeconds        Int             @default(0)
  status                 String          @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, TIMED_OUT, CANCELLED
  totalMarksEarned       Float           @default(0.0)
  maxMarks               Float           @default(0.0)
  percentage             Float           @default(0.0)
  isPassed               Boolean         @default(false)
  currentQuestionIndex   Int             @default(0)
  antiCheatIncidentsJson String?         // JSON array of logged incidents
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  answers                AttemptAnswer[]
  result                 Result?

  @@index([companyId])
  @@index([examId])
  @@index([userId])
  @@index([status])
}

model AttemptAnswer {
  id                    String          @id @default(cuid())
  attemptId             String
  attempt               ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId            String
  question              Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIdsJson String?         // JSON array of selected Option IDs
  textAnswer            String?         // Text response
  isCorrect             Boolean?
  marksEarned           Float           @default(0.0)
  feedback              String?
  isFlaggedForReview    Boolean         @default(false)
  answeredAt            DateTime        @default(now())

  @@index([attemptId])
  @@index([questionId])
}

// ---------------------------------------------------------
// 6. SCORES, RESULTS & CERTIFICATES
// ---------------------------------------------------------
model Result {
  id                 String          @id @default(cuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attemptId          String          @unique
  attempt            ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examId             String
  exam               Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalScore         Float
  maxScore           Float
  percentage         Float
  isPassed           Boolean
  correctCount       Int
  wrongCount         Int
  unansweredCount    Int
  timeSpentSeconds   Int
  gradedAt           DateTime        @default(now())
  topicBreakdownJson String?         // JSON object detailing topic-by-topic % performance

  certificate        Certificate?
  aiAnalysis         AIAnalysis?

  @@index([companyId])
  @@index([examId])
  @@index([userId])
  @@index([isPassed])
}

model Certificate {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resultId          String          @unique
  result            Result          @relation(fields: [resultId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId            String
  exam              Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  certNumber        String          @unique
  issueDate         DateTime        @default(now())
  expiryDate        DateTime?
  status            String          @default("VALID") // VALID, EXPIRED, REVOKED
  verificationToken String          @unique @default(cuid())
  pdfUrl            String?
  metadataJson      String?         // Additional metadata
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([examId])
  @@index([verificationToken])
  @@index([certNumber])
}

// ---------------------------------------------------------
// 7. AI ANALYSIS & TRAINING COURSES / ENROLLMENTS
// ---------------------------------------------------------
model AIAnalysis {
  id                       String          @id @default(cuid())
  companyId                String
  company                  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resultId                 String          @unique
  result                   Result          @relation(fields: [resultId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallSummary           String
  weakTopicsJson           String          // JSON array of weak topics
  strongTopicsJson         String          // JSON array of strong topics
  improvementRoadmapJson   String          // JSON array of step-by-step actions
  recommendedActionsJson   String          // JSON array of course/assessment suggestions
  createdAt                DateTime        @default(now())

  @@index([companyId])
  @@index([userId])
}

model TrainingRecommendation {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicTitle      String
  courseTitle     String
  description     String
  priority        String           @default("MEDIUM") // HIGH, MEDIUM, LOW
  status          String           @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([status])
}

model TrainingCourse {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  code           String
  description    String?
  category       String               @default("Technical")
  difficulty     String               @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  durationHours  Float                @default(10.0)
  status         String               @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  syllabusJson   String?              // JSON structure of syllabus modules
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  enrollments    TrainingEnrollment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
}

model TrainingEnrollment {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  courseId        String
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String         @default("ENROLLED") // ENROLLED, IN_PROGRESS, COMPLETED, DROPPED
  progressPercent Float          @default(0.0)
  score           Float?
  enrolledAt      DateTime       @default(now())
  completedAt     DateTime?
  updatedAt       DateTime       @updatedAt

  @@unique([courseId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

// ---------------------------------------------------------
// 8. ASSESSMENTS
// ---------------------------------------------------------
model Assessment {
  id               String                 @id @default(cuid())
  companyId        String
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  code             String
  description      String?
  type             String                 @default("PRE_HIRE") // PRE_HIRE, PROMOTION, ANNUAL_REVIEW, SKILL_GAP
  passingScore     Float                  @default(70.0)
  status           String                 @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  examId           String?
  exam             Exam?                  @relation(fields: [examId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  submissions      AssessmentSubmission[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
}

model AssessmentSubmission {
  id             String      @id @default(cuid())
  assessmentId   String
  assessment     Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Float       @default(0.0)
  isPassed       Boolean     @default(false)
  feedback       String?
  submittedAt    DateTime    @default(now())

  @@index([assessmentId])
  @@index([userId])
}

// ---------------------------------------------------------
// 9. NOTIFICATIONS & AUDIT LOGS
// ---------------------------------------------------------
model Notification {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  message         String
  type            String           @default("SYSTEM") // EXAM_ASSIGNED, EXAM_DEADLINE, RESULT_AVAILABLE, CERTIFICATE_ISSUED, CERT_EXPIRING, SYSTEM
  isRead          Boolean          @default(false)
  linkUrl         String?
  createdAt       DateTime         @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([isRead])
}

model AuditLog {
  id              String           @id @default(cuid())
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail       String?
  action          String           // LOGIN, LOGOUT, CREATE_USER, CREATE_EXAM, SUBMIT_EXAM, ISSUE_CERT, etc.
  entity          String           // USER, EXAM, RESULT, CERTIFICATE, COMPANY, etc.
  entityId        String?
  detailsJson     String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime         @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
